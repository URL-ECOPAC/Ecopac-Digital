{
  "name": "ecopac-digital",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=apps/web -- --host",
    "dev:mobile": "npm run start --workspace=apps/mobile --",
    "dev:mobilet": "npm run start --workspace=apps/mobile -- --tunnel",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker compose --env-file .env.production -f docker-compose.prod.yml up --build -d",
    "verificar:concurrencia-ficha": "node scripts/verificar-concurrencia-numero-ficha.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.0.0",
    "pg": "^8.13.1",
    "prettier": "^3.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.0.0"
    }
  },
  "dependencies": {
    "docker": "^1.0.0"
  }
}

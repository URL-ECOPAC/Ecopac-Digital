{
  "name": "ecopac-digital",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=apps/web -- --host",
    "dev:mobile": "npm run start --workspace=apps/mobile --",
    "dev:mobilet": "npm run start --workspace=apps/mobile -- --tunnel",
    "lint": "npm run lint --workspaces --if-present && eslint pruebas",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "vitest run --config pruebas/e2e/vitest.config.mjs",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json}\"",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker compose --env-file .env.production -f docker-compose.prod.yml up --build -d",
    "verificar:concurrencia-ficha": "node scripts/verificar-concurrencia-numero-ficha.mjs",
    "verificar:shared-esquema": "node scripts/verificar-shared-vs-esquema.mjs",
    "verificar:sin-emojis": "node scripts/verificar-sin-emojis.mjs",
    "verificar:paleta": "node scripts/verificar-paleta.mjs",
    "verificar:redireccion": "node scripts/verificar-redireccion-recuperacion.mjs",
    "verificar:contratos": "node scripts/verificar-contratos-de-api.mjs",
    "verificar:rewrite-vercel": "node scripts/verificar-rewrite-vercel.mjs",
    "verificar:cabeceras-http": "node scripts/verificar-cabeceras-http.mjs",
    "verificar:jsdoc": "node scripts/verificar-jsdoc.mjs",
    "docs:diccionario": "node scripts/generar-diccionario-de-datos.mjs",
    "docs:pantallas": "node scripts/generar-mapa-de-pantallas.mjs",
    "prueba:carga-jornada": "vitest run --config scripts/vitest.carga.config.mjs --reporter=verbose"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.3.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.0.0"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "html2pdf.js": "^0.14.0"
  }
}

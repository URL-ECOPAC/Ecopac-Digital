# Copia este archivo a .env.development o .env.production y llena los valores reales.
# Nunca subas el archivo con las llaves reales al repositorio.

# --- Supabase ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mismas variables para React Native / Expo (prefijo EXPO_PUBLIC_)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Configuración general ---
NODE_ENV=development

# --- Correo de las Edge Functions (issue #755, ampliado en la #864) ---
# Estas NO las lee la web ni el movil: son de las Edge Functions. En local van en
# supabase/functions/.env (ignorado por git) y se pasan con
#   supabase functions serve --env-file supabase/functions/.env
# En ecopac-dev / ecopac-prod se configuran como secrets de las funciones (docs/CI-CD.md).
# Los valores de abajo son los del stack local: Mailpit recibe el correo sin mandarlo a nadie
# y lo muestra en http://localhost:54424.
#
# SMTP_HOST es `inbucket` a secas, que es el alias de red que el propio `supabase start` le pone
# al contenedor de Mailpit. El nombre largo del contenedor
# (`supabase_inbucket_ecopac-digital`) no resuelve desde el runtime de las funciones, y el fallo
# que devuelve -- `getaddrinfo ENOTFOUND` -- no llega a la pantalla: la invitacion se guarda
# igual y el correo nunca sale.
SMTP_HOST=inbucket
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ecopac Digital <no-responder@ecopac.test>"

# WEB_URL la usan DOS funciones, y sin ella las dos degradan en silencio:
#   - enviar-notificaciones: para los enlaces de cada notificacion.
#   - invitar-usuario (issue #864): para mandar el correo de invitacion a
#     `${WEB_URL}/nueva-contrasena`. Sin esta variable gana el Site URL de Supabase Auth, que
#     apunta a la raiz, y la persona invitada aterriza con sesion y sin contrasena, sin nada que
#     la lleve a ponerse una.
# En los proyectos remotos, el destino tiene que estar ademas en Authentication > URL
# Configuration > Redirect URLs, o Supabase lo ignora y vuelve a caer en el Site URL.
WEB_URL=http://localhost:5173

# Copia este archivo a .env.development o .env.production y llena los valores reales.
# Nunca subas el archivo con las llaves reales al repositorio.

# --- Supabase ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mismas variables para React Native / Expo (prefijo EXPO_PUBLIC_)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Configuración general ---
NODE_ENV=development

# --- Correo de las notificaciones al administrador (issue #755) ---
# Estas NO las lee la web ni el movil: son de las Edge Functions. En local van en
# supabase/functions/.env (ignorado por git) y se pasan con
#   supabase functions serve --env-file supabase/functions/.env
# En ecopac-dev / ecopac-prod se configuran como secrets de las funciones (docs/CI-CD.md).
# Los valores de abajo son los del stack local: Mailpit recibe el correo sin mandarlo a nadie
# y lo muestra en http://localhost:54424.
SMTP_HOST=supabase_inbucket_ecopac-digital
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ecopac Digital <no-responder@ecopac.test>"
WEB_URL=http://localhost:5173
